---
import { ui } from '../i18n/ui';
const { lang } = Astro.props;
const t = ui(lang);

const cards = [
  { icon: '🏷️', label: t.infoCards.labels.type, value: t.infoCards.type },
  { icon: '📍', label: t.infoCards.labels.address, value: t.infoCards.address },
  { icon: '🕒', label: t.infoCards.labels.hours, value: t.infoCards.hours },
  { icon: '📞', label: t.infoCards.labels.phone, value: t.infoCards.phone },
  { icon: '⭐', label: t.infoCards.labels.rating, value: `${t.infoCards.ratingText} · ${t.infoCards.reviews}` },
];
---
<section id="info" class="bg-sand py-16">
  <div class="mx-auto max-w-6xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold">{t.infoCards.title}</p>
      <h2 class="mt-2 font-serif text-2xl font-bold text-brown md:text-3xl">{t.infoCards.name}</h2>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {cards.map((c) => (
        <div class="rounded-2xl border border-sand-dark bg-cream p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <div class="text-2xl">{c.icon}</div>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-brown-light">{c.label}</p>
          <p class="mt-1 text-sm font-medium text-brown">{c.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>
