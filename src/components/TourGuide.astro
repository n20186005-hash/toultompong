---
import { ui } from '../i18n/ui';
const { lang } = Astro.props;
const t = ui(lang);
---
<section class="bg-cream py-16">
  <div class="mx-auto max-w-6xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold">{t.tourGuide.title}</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-brown md:text-4xl">{t.tourGuide.title}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-brown-light">{t.tourGuide.intro}</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {t.tourGuide.plans.map((plan: any) => (
        <div class="rounded-2xl border border-sand-dark bg-sand p-6 shadow-sm">
          <h3 class="font-serif text-xl font-bold text-brown">{plan.title}</h3>
          <ol class="mt-4 space-y-3">
            {plan.steps.map((s: string, i: number) => (
              <li class="flex items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-brown">{i + 1}</span>
                <span class="text-brown">{s}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
