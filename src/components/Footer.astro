---
import { ui } from '../i18n/ui';
import { base } from '../i18n/ui';
const { lang } = Astro.props;
const t = ui(lang);
const year = new Date().getFullYear();
const legal = (p: string) => {
  const langPath = (base === '/' || base === '') ? `/${lang}` : `${base}/${lang}`;
  return `${langPath}/${p}`;
};
---
<footer class="bg-brown py-12 text-cream">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 md:flex-row md:items-start md:justify-between">
    <div class="max-w-2xl text-sm leading-relaxed text-cream/80">
      <p>© {year} {t.footer.siteName} · {lang === 'zh' ? '版权所有' : lang === 'km' ? 'រក្សាសិទ្ធិគ្រប់យ៉ាង' : 'All rights reserved'}</p>
      <p class="mt-2">{lang === 'zh' ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。' : lang === 'km' ? 'គេហទំព័រនេះជាគម្រោងព័ត៌មានទេសចរណ៍ឯករាជ្យ។ យើងមិនមានទំនាក់ទំនងជាមួយស្ថាប័នរដ្ឋាភិបាល ឬអង្គការផ្លូវការណាមួយឡើយ។' : 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.'}</p>
    </div>
    <nav aria-label={lang === 'zh' ? '法律与隐私' : lang === 'km' ? 'គោលការណ៍ និងឯកជនភាព' : 'Legal and privacy'} class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-cream/80 md:justify-end md:text-right">
      <a href={legal('privacy-policy')} class="hover:text-gold">{t.footer.privacyLabel}</a>
      <a href={legal('terms-of-service')} class="hover:text-gold">{t.footer.termsLabel}</a>
      <a href={legal('cookie-settings')} class="hover:text-gold">{t.footer.cookiesLabel}</a>
    </nav>
  </div>
</footer>
