---
import { ui } from '../i18n/ui';
import { siteConfig } from '../config/site';
import { base } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
const { lang } = Astro.props;
const t = ui(lang);
const year = new Date().getFullYear();
const legal = (p: string) => (base === '/' || base === '') ? `/${p}` : `${base}/${p}`;
---
<footer class="bg-brown py-12 text-cream">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-3">
    <div>
      <h3 class="font-serif text-lg font-bold">{t.footer.siteName}</h3>
      <p class="mt-2 text-sm text-cream/70">{t.footer.tagline}</p>
    </div>
    <div>
      <p class="text-sm leading-relaxed text-cream/70">{t.footer.disclaimer}</p>
    </div>
    <div class="text-sm">
      <p class="font-semibold text-gold-soft">{t.footer.langTitle}</p>
      <div class="mt-2"><LanguageSwitcher lang={lang} /></div>
      <a href={siteConfig.mapsUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-cream/80 hover:text-gold">
        📍 {t.footer.mapsLabel} ↗
      </a>
    </div>
  </div>
  <div class="mx-auto mt-8 max-w-6xl border-t border-cream/15 px-4 pt-6 text-center text-xs text-cream/60">
    © {year} {t.footer.siteName}. {t.footer.rights}
    <span class="mx-2">·</span>
    <a href={legal('privacy-policy')} class="hover:text-gold">Privacy</a>
    <span class="mx-1">·</span>
    <a href={legal('terms-of-service')} class="hover:text-gold">Terms</a>
    <span class="mx-1">·</span>
    <a href={legal('cookie-settings')} class="hover:text-gold">Cookies</a>
  </div>
</footer>
