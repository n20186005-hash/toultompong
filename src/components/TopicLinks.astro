---
import { ui } from '../i18n/ui';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = (ui(lang).topicLinks as any) ?? { title: '', subtitle: '', items: [] };
---

<section class="mx-auto max-w-5xl px-4 py-12" data-reveal>
  <h2 class="font-serif text-2xl font-semibold text-stone-800">{t.title}</h2>
  <p class="mt-2 text-stone-600">{t.subtitle}</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {t.items?.map((it: any) => (
      <a
        href={it.href}
        class="block rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-amber-400 hover:shadow"
      >
        <span class="font-semibold text-stone-800">{it.label}</span>
      </a>
    ))}
  </div>
  <a href="/en/guides" class="mt-5 inline-flex rounded-xl border border-amber-300 bg-amber-50 px-5 py-3 font-semibold text-amber-900 hover:bg-amber-100">
    {lang === 'zh' ? '更多俄罗斯市场专题指南（英文）' : lang === 'km' ? 'មគ្គុទ្ទេសក៍បន្ថែម (ភាសាអង់គ្លេស)' : 'Explore more Russian Market guides'} →
  </a>
</section>
