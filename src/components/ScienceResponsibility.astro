---
import { ui } from '../i18n/ui';
const { lang } = Astro.props;
const t = ui(lang);
---
<section id="responsibility" class="bg-sand-light py-16">
  <div class="mx-auto max-w-5xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold">{t.scienceResponsibility.sectionEyebrow}</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-brown md:text-4xl">{t.scienceResponsibility.sectionTitle}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-brown-light">{t.scienceResponsibility.intro}</p>
    </div>

    <article class="mt-10 rounded-2xl border border-sand-dark bg-cream p-7 shadow-sm">
      <h3 class="font-serif text-2xl font-bold text-brown">{t.scienceResponsibility.background.title}</h3>
      <div class="mt-3 space-y-3 text-brown leading-relaxed">
        {t.scienceResponsibility.background.body.map((p: string) => <p>{p}</p>)}
      </div>
    </article>

    <article class="mt-8 rounded-2xl border border-sand-dark bg-brown-light/10 p-7 shadow-sm">
      <h3 class="font-serif text-2xl font-bold text-brown">{t.scienceResponsibility.legends.title}</h3>
      <div class="mt-3 space-y-3 text-brown leading-relaxed">
        {t.scienceResponsibility.legends.body.map((p: string) => <p>{p}</p>)}
      </div>
    </article>

    <article class="mt-8 rounded-2xl border border-gold/30 bg-gold/5 p-7 shadow-sm">
      <h3 class="font-serif text-2xl font-bold text-brown">{t.scienceResponsibility.responsibility.title}</h3>
      <ul class="mt-3 space-y-3 list-disc pl-5 text-brown leading-relaxed">
        {t.scienceResponsibility.responsibility.items.map((p: string) => <li>{p}</li>)}
      </ul>
    </article>
  </div>
</section>
