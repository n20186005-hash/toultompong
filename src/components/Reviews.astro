---
import { ui } from '../i18n/ui';
import { siteConfig } from '../config/site';
const { lang } = Astro.props;
const t = ui(lang);
---
<section class="bg-brown py-16 text-cream">
  <div class="mx-auto max-w-6xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold-soft">{t.reviews.title}</p>
      <h2 class="mt-2 font-serif text-3xl font-bold md:text-4xl">{t.reviews.title}</h2>
    </div>

    <div class="mt-8 flex flex-col items-center gap-2 text-center">
      <div class="text-5xl font-bold text-gold">{t.reviews.rating}</div>
      <div class="text-lg text-cream/85">{t.reviews.reviews}</div>
      <div class="text-xl" aria-label={t.reviews.rating}>
        <span class="text-gold">★★★★</span><span class="text-cream/30">★</span>
      </div>
      <p class="text-sm text-cream/60">
        {t.reviews.sourceLine1}
        <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-gold-soft hover:text-gold underline">
          {t.reviews.sourceLink1}↗
        </a>
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-brown-light p-6">
        <h3 class="font-serif text-xl font-bold text-gold">{t.reviews.prosTitle}</h3>
        <ul class="mt-3 space-y-2">
          {t.reviews.pros.map((p: string) => (
            <li class="flex items-start gap-2"><span class="text-gold">✓</span><span class="text-cream/90">{p}</span></li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-brown-light p-6">
        <h3 class="font-serif text-xl font-bold text-gold">{t.reviews.notesTitle}</h3>
        <ul class="mt-3 space-y-2">
          {t.reviews.notes.map((n: string) => (
            <li class="flex items-start gap-2"><span class="text-gold">ℹ</span><span class="text-cream/90">{n}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center gap-3 text-center">
      <p class="text-xs text-cream/50 max-w-2xl">
        {t.reviews.sourceAttribution}
      </p>
      <a
        href={siteConfig.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 font-semibold text-brown shadow-lg transition hover:bg-gold-dark"
      >
        📍 {t.reviews.viewAllButton} ↗
      </a>
    </div>
  </div>
</section>
