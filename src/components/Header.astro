---
import { ui } from '../i18n/ui';
import { base } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
const { lang } = Astro.props;
const t = ui(lang);
const homeHref = lang === 'km' ? `${base}/km/` : `${base}/${lang}/`;
const navEntries = Object.entries(t.header.nav) as [string, string][];
---
<header class="sticky top-0 z-50 bg-brown/95 backdrop-blur text-cream shadow-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 h-16">
    <a href={homeHref} class="flex flex-col leading-tight">
      <span class="font-serif text-lg font-bold">{t.header.siteName}</span>
      <span class="text-[11px] tracking-wide text-gold-soft">{t.header.tagline}</span>
    </a>

    <nav class="hidden md:flex items-center gap-5 text-sm">
      {navEntries.map(([key, label]) => (
        <a href={`#${key}`} class="text-cream/85 hover:text-gold transition">{label}</a>
      ))}
    </nav>

      <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />
      <details class="relative md:hidden">
        <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-cream/30 text-xl">☰</summary>
        <nav class="absolute right-0 mt-2 w-48 rounded-lg bg-brown p-3 shadow-xl flex flex-col gap-1">
          {navEntries.map(([key, label]) => (
            <a href={`#${key}`} class="rounded px-3 py-2 text-sm text-cream/90 hover:bg-brown-light">{label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
