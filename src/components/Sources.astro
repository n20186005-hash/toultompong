---
import { ui } from '../i18n/ui';
import { siteConfig } from '../config/site';
const { lang } = Astro.props;
const t = ui(lang);
---
<section id="sources" class="bg-sand py-16">
  <div class="mx-auto max-w-4xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold">{t.sources.sectionEyebrow}</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-brown md:text-4xl">{t.sources.sectionTitle}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-brown-light">{t.sources.intro}</p>
    </div>

    <div class="mt-10 space-y-5">
      {t.sources.items.map((item: any, i: number) => {
        const linkUrl =
          i === 0
            ? siteConfig.mapsUrl
            : i === 1
            ? siteConfig.govTourismUrl
            : siteConfig.mapsUrl;
        return (
          <article class="rounded-2xl border border-sand-dark bg-cream p-6 shadow-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-serif text-xl font-bold text-brown">{item.title}</h3>
              <span class="text-xs font-semibold uppercase tracking-wide text-gold">{item.meta}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-brown-light">{item.desc}</p>
            <a
              href={linkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block text-sm font-semibold text-brown hover:text-gold-dark"
            >
              {item.linkLabel} ↗
            </a>
          </article>
        );
      })}
    </div>

    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-brown-light">
      {t.tourismLink.label}{' '}
      <a
        href={siteConfig.govTourismUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-brown hover:text-gold-dark underline"
      >
        {t.tourismLink.linkText} ↗
      </a>
    </p>
  </div>
</section>
