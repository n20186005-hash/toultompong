---
import { ui } from '../i18n/ui';
import { siteConfig } from '../config/site';
const { lang } = Astro.props;
const t = ui(lang);
---
<section id="location" class="bg-sand py-16">
  <div class="mx-auto max-w-6xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold">{t.map.title}</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-brown md:text-4xl">{t.map.title}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-brown-light">{t.map.caption}</p>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl shadow-md">
      <iframe
        class="map-frame"
        src={siteConfig.embedUrl}
        title={t.map.title}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-brown-light">
      <a href={siteConfig.mapsUrl} target="_blank" rel="noopener" class="font-semibold text-brown hover:text-gold-dark">
        📍 {t.footer.mapsLabel} ↗
      </a>
      <span>📌 {siteConfig.plusCode} · {siteConfig.lat}, {siteConfig.lng}</span>
    </div>
  </div>
</section>
