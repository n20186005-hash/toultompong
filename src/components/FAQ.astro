---
import { ui } from '../i18n/ui';
const { lang } = Astro.props;
const t = ui(lang);
---
<section id="faq" class="bg-cream py-16">
  <div class="mx-auto max-w-3xl px-4" data-reveal>
    <h2 class="text-center font-serif text-3xl font-bold text-brown md:text-4xl">{t.faq.title}</h2>

    <div class="mt-8 space-y-3">
      {t.faq.items.map((it: any) => (
        <details class="group rounded-2xl border border-sand-dark bg-sand p-4">
          <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-brown">
            <span>{it.q}</span>
            <span class="text-gold transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-2 leading-relaxed text-brown-light">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
