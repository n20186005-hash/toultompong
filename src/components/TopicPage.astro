---
import { ui } from '../i18n/ui';
import Gallery from './Gallery.astro';

interface Props {
  lang: string;
  topic: 'openingHours' | 'photos' | 'whatToBuy' | 'directions';
}
const { lang, topic } = Astro.props;
const t = ui(lang);
const data = (t.topics as Record<string, any>)[topic] ?? { title: '', intro: '', sections: [], faq: [] };
const homeHref = `/${lang}`;
---

<section class="mx-auto max-w-3xl px-4 py-12" data-reveal>
  <a href={homeHref} class="inline-flex items-center gap-1 text-sm text-amber-700 hover:underline mb-6">← {t.header.nav.overview}</a>
  <h1 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900">{data.title}</h1>
  <p class="mt-3 text-base leading-relaxed text-stone-600">{data.intro}</p>

  {data.showGallery && (
    <div class="my-8">
      <Gallery lang={lang} />
    </div>
  )}

  {data.sections?.map((s: any) => (
    <div class="mt-8">
      <h2 class="font-serif text-xl font-semibold text-stone-800">{s.h}</h2>
      <p class="mt-2 text-stone-600 leading-relaxed">{s.p}</p>
    </div>
  ))}

  <div class="mt-10">
    <h2 class="font-serif text-2xl font-semibold text-stone-800">{t.faq.title}</h2>
    <div class="mt-4 space-y-4">
      {data.faq?.map((f: any) => (
        <div class="rounded-2xl border border-stone-200 bg-white p-4">
          <h3 class="font-semibold text-stone-800">{f.q}</h3>
          <p class="mt-1 text-stone-600">{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
