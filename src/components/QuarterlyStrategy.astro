---
import { ui } from '../i18n/ui';
const { lang } = Astro.props;
const t = ui(lang);
---
<section id="seasons" class="bg-sand-light py-16">
  <div class="mx-auto max-w-6xl px-4" data-reveal>
    <div class="text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gold">{t.quarterStrategy.sectionEyebrow}</p>
      <h2 class="mt-2 font-serif text-3xl font-bold text-brown md:text-4xl">{t.quarterStrategy.sectionTitle}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-brown-light">{t.quarterStrategy.intro}</p>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-sand-dark bg-cream shadow-sm">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-brown text-cream">
            <th class="px-4 py-3 text-left font-semibold">{t.quarterStrategy.table.quarterHeader}</th>
            <th class="px-4 py-3 text-left font-semibold">{t.quarterStrategy.table.weatherHeader}</th>
            <th class="px-3 py-3 text-left font-semibold">{t.quarterStrategy.table.rainfallHeader}</th>
            <th class="px-3 py-3 text-left font-semibold">{t.quarterStrategy.table.crowdHeader}</th>
            <th class="px-3 py-3 text-left font-semibold">{t.quarterStrategy.table.recommendationHeader}</th>
            <th class="px-3 py-3 text-left font-semibold">{t.quarterStrategy.table.notesHeader}</th>
          </tr>
        </thead>
        <tbody>
          {t.quarterStrategy.rows.map((row: any, i: number) => (
            <tr class={i % 2 === 0 ? 'bg-cream' : 'bg-sand-light/40'}>
              <td class="border-t border-sand-dark px-4 py-3 font-semibold text-brown">{row.quarter}</td>
              <td class="border-t border-sand-dark px-4 py-3 text-brown">{row.weather}</td>
              <td class="border-t border-sand-dark px-3 py-3 text-brown">{row.rainfall}</td>
              <td class="border-t border-sand-dark px-3 py-3 text-brown">{row.crowd}</td>
              <td class="border-t border-sand-dark px-3 py-3 font-medium text-brown">{row.recommendation}</td>
              <td class="border-t border-sand-dark px-3 py-3 text-brown-light">{row.notes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mx-auto mt-5 max-w-3xl text-center text-xs text-brown-light">{t.quarterStrategy.legend}</p>
  </div>
</section>
