---
import { ui } from '../i18n/ui';
import { siteConfig } from '../config/site';
const { lang } = Astro.props;
const t = ui(lang);
const heroImg = siteConfig.gallery[0];
---
<section id="overview" class="relative flex min-h-[88vh] items-center overflow-hidden">
  <img src={heroImg} alt={t.hero.title} class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-r from-brown/90 via-brown/65 to-transparent"></div>
  <div class="relative mx-auto w-full max-w-6xl px-4 py-24 text-cream" data-reveal>
    <p class="text-sm uppercase tracking-[0.3em] text-gold-soft">{t.hero.eyebrow}</p>
    <h1 class="mt-3 font-serif text-4xl font-bold leading-tight md:text-6xl">
      {t.hero.title} <span class="text-gold">{t.hero.titleSub}</span>
    </h1>
    <p class="mt-5 max-w-xl text-lg text-cream/90">{t.hero.subtitle}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#location" class="inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 font-semibold text-brown shadow-lg transition hover:bg-gold-dark">
        📍 {t.hero.ctaMap}
      </a>
      <a href="#info" class="inline-flex items-center gap-2 rounded-full border border-cream/70 px-6 py-3 font-semibold text-cream transition hover:bg-cream/10">
        🧭 {t.hero.ctaExplore}
      </a>
    </div>
  </div>
</section>
