---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BASE } from '../../../config/site';
import { nearbyPlaces } from '../../../data/nearbyPlaces';
export const prerender=true;
export function getStaticPaths(){return (['en','zh','km'] as const).flatMap(lang=>nearbyPlaces.map(place=>({params:{lang,slug:place.slug},props:{lang,place}})));}
const {lang,place}=Astro.props;
const t=place[lang as 'en'|'zh'|'km'];
const canonical=`${BASE}/${lang}/nearby/${place.slug}`;
const alternates=['en','zh','km'].map(code=>({code,href:`${BASE}/${code}/nearby/${place.slug}`}));
const copy={
 en:{back:'Back to Russian Market',nearby:'Explore nearby',about:'About and management',basics:'Essential information',hours:'Opening hours',hoursText:'Check current times directly with the venue.',admission:'Tickets and cost',admissionText:'Verify today’s entry fees and conditions with the venue.',transport:'Getting there',transportText:'Use a tuk-tuk, taxi or suitable transport; check current route and fare. This is a separate destination from Russian Market.',history:'History',architecture:'Architecture and observation points',culture:'Culture and experience',visit:'Visiting advice',route:'Suggested itinerary',notes:'Visitor notes',notesText:'Respect on-site instructions, protect your belongings and allow extra time for traffic. Confirm facilities and accessibility at the venue.',photo:'Photography spots',lodging:'Accommodation',lodgingText:'Choose lodging for your full Phnom Penh itinerary and compare real-time availability and transit routes.',reviews:'Visitor feedback',reviewsText:'For live ratings and review counts, check this destination’s own Google Maps listing.',directions:'Address and navigation',map:'Open this attraction in Google Maps',faq:'Frequently asked questions',source:'Sources and updates',update:'Editorial check: 16 November 2026. Hours, prices and access can change.',more:'More nearby places'},
 zh:{back:'返回俄罗斯市场',nearby:'周边景点',about:'关于景点与管理主体',basics:'基本信息',hours:'开放时间',hoursText:'请通过景点自己的官方渠道核实当天时段。',admission:'门票价格',admissionText:'实际票价与入场条件请向景点管理方现场核实。',transport:'交通方式',transportText:'可乘突突车、出租车等交通工具，提前确认路线和费用。这是俄罗斯市场以外的独立地点。',history:'历史背景',architecture:'建筑特色与观察重点',culture:'文化与核心体验',visit:'游览建议',route:'建议游览路线',notes:'游览须知',notesText:'遵守现场规定，保管财物，预留交通时间；设施与无障碍条件请现场核实。',photo:'拍照机位',lodging:'住宿建议',lodgingText:'按整个金边行程选择住处，住宿房态与交通请直接查询。',reviews:'游客评价',reviewsText:'即时评分与评论数量请查看该景点自己的 Google 地图地点页。',directions:'地址与交通指南',map:'打开该景点的 Google 地图',faq:'常见问答',source:'来源与更新时间',update:'内容核对：2026年11月16日。开放、门票与交通可能变化。',more:'更多周边景点'},
 km:{back:'ត្រឡប់ទៅផ្សារទួលទំពូង',nearby:'កន្លែងទស្សនាជុំវិញ',about:'អំពីទីតាំង និងការគ្រប់គ្រង',basics:'ព័ត៌មានមូលដ្ឋាន',hours:'ម៉ោងបើក',hoursText:'ពិនិត្យម៉ោងបច្ចុប្បន្នដោយផ្ទាល់ជាមួយទីតាំង។',admission:'ថ្លៃចូល',admissionText:'សូមផ្ទៀងផ្ទាត់ថ្លៃ និងលក្ខខណ្ឌនៅទីតាំង។',transport:'ការធ្វើដំណើរ',transportText:'អាចជិះតុកតុក ឬតាក់ស៊ី ដោយបញ្ជាក់ផ្លូវ និងថ្លៃជាមុន។ ទីនេះមិនមែនផ្សារទួលទំពូងទេ។',history:'ប្រវត្តិសាស្ត្រ',architecture:'ស្ថាបត្យកម្ម និងចំណុចសង្កេត',culture:'វប្បធម៌ និងបទពិសោធន៍',visit:'ដំបូន្មានទស្សនា',route:'លំដាប់ទស្សនាដែលណែនាំ',notes:'ការណែនាំអ្នកទស្សនា',notesText:'គោរពបទបញ្ជានៅទីតាំង ថែរក្សាទ្រព្យសម្បត្តិ និងទុកពេលធ្វើដំណើរ។ សួរអំពីសេវា និងការចូលប្រើប្រាស់។',photo:'ចំណុចថតរូប',lodging:'កន្លែងស្នាក់នៅ',lodgingText:'ជ្រើសកន្លែងស្នាក់នៅតាមកម្មវិធីទស្សនាភ្នំពេញ និងពិនិត្យសេវាបច្ចុប្បន្ន។',reviews:'មតិអ្នកទស្សនា',reviewsText:'សូមមើលពិន្ទុ និងមតិថ្មីនៅផែនទី Google របស់ទីតាំងនេះ។',directions:'អាសយដ្ឋាន និងផែនទី',map:'បើកផែនទី Google នៃទីតាំងនេះ',faq:'សំណួរញឹកញាប់',source:'ប្រភព និងកាលបរិច្ឆេទ',update:'ពិនិត្យព័ត៌មាន៖ ១៦ វិច្ឆិកា ២០២៦។ ម៉ោង និងថ្លៃអាចផ្លាស់ប្តូរ។',more:'កន្លែងផ្សេងទៀត'}
}[lang as 'en'|'zh'|'km'];
const article={'@context':'https://schema.org','@type':'TouristAttraction',name:t.name,description:t.intro,url:canonical,image:`${BASE}${place.photo}`,hasMap:place.map,address:place.address};
---
<BaseLayout lang={lang} seoTitle={`${t.name} | Phnom Penh Visitor Guide`} seoDescription={t.intro} alternates={alternates} alternateDefault={`${BASE}/en/nearby/${place.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  <article class="mx-auto max-w-5xl px-4 py-12 text-stone-800" data-reveal>
    <nav class="mb-6 text-sm text-amber-800"><a href={`/${lang}#nearby`}>{copy.back}</a> / <a href={`/${lang}/nearby`}>{copy.nearby}</a> / {t.name}</nav>
    <section class="rounded-3xl bg-amber-50 p-6 sm:p-10"><p class="text-sm uppercase tracking-wider text-amber-800">{copy.nearby} · Phnom Penh</p><h1 class="mt-2 font-serif text-3xl font-bold sm:text-4xl">{t.name}</h1><p class="mt-2 text-xl text-stone-600">{t.tagline}</p><p class="mt-5 leading-7">{t.intro}</p><a href={place.map} target="_blank" rel="noopener" class="mt-5 inline-flex rounded-full bg-amber-800 px-5 py-3 text-white">{copy.map} ↗</a></section>
    <section class="mt-9 grid gap-7 md:grid-cols-2"><img src={place.photo} alt={t.name} loading="eager" class="h-full w-full rounded-2xl object-cover"/><div class="rounded-2xl border border-stone-200 p-6"><h2 class="font-serif text-2xl font-bold">{copy.about}</h2><p class="mt-4 leading-7">{t.management}</p></div></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">{copy.basics}</h2><dl class="mt-4 grid gap-4 sm:grid-cols-2"><div><dt class="font-semibold">{copy.directions}</dt><dd>{place.address}</dd></div><div><dt class="font-semibold">{copy.hours}</dt><dd>{copy.hoursText}</dd></div><div><dt class="font-semibold">{copy.admission}</dt><dd>{copy.admissionText}</dd></div><div><dt class="font-semibold">{copy.transport}</dt><dd>{copy.transportText}</dd></div></dl></section>
    <section class="mt-10 grid gap-7 md:grid-cols-2"><div><h2 class="font-serif text-2xl font-bold">{copy.history}</h2><p class="mt-3 leading-7">{t.history}</p></div><div><h2 class="font-serif text-2xl font-bold">{copy.architecture}</h2><p class="mt-3 leading-7">{t.architecture}</p></div><div><h2 class="font-serif text-2xl font-bold">{copy.culture}</h2><p class="mt-3 leading-7">{t.culture}</p></div><div><h2 class="font-serif text-2xl font-bold">{copy.visit}</h2><p class="mt-3 leading-7">{t.visit}</p></div></section>
    <section class="mt-10 rounded-2xl bg-stone-50 p-6"><h2 class="font-serif text-2xl font-bold">{copy.route}</h2><ol class="mt-5 space-y-4">{t.route.map((step,i)=><li class="flex gap-4"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-800 text-white">{i+1}</span><p class="leading-7">{step}</p></li>)}</ol></section>
    <section class="mt-10 grid gap-8 sm:grid-cols-2"><div><h2 class="font-serif text-xl font-bold">{copy.notes}</h2><p class="mt-2 leading-7">{copy.notesText}</p></div><div><h2 class="font-serif text-xl font-bold">{copy.photo}</h2><p class="mt-2 leading-7">{t.photo}</p></div><div><h2 class="font-serif text-xl font-bold">{copy.lodging}</h2><p class="mt-2 leading-7">{copy.lodgingText}</p></div><div><h2 class="font-serif text-xl font-bold">{copy.reviews}</h2><p class="mt-2 leading-7">{copy.reviewsText}</p></div></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">{copy.faq}</h2><div class="mt-4 space-y-4">{t.faq.map(([q,a])=><div class="rounded-xl border border-stone-200 p-5"><h3 class="font-semibold">{q}</h3><p class="mt-2 leading-7">{a}</p></div>)}</div></section>
    <section class="mt-10 border-t pt-7"><h2 class="font-serif text-2xl font-bold">{copy.directions}</h2><p class="mt-3">{place.address}</p><a class="mt-3 inline-flex text-amber-800 underline" href={place.map} target="_blank" rel="noopener">{copy.map} ↗</a><h2 class="mt-9 font-serif text-xl font-bold">{copy.source}</h2><p class="mt-2 text-sm text-stone-600">{copy.update} <a class="underline" href={place.source} target="_blank" rel="noopener">{place.source}</a></p><h2 class="mt-8 font-serif text-xl font-bold">{copy.more}</h2><div class="mt-3 grid gap-4 sm:grid-cols-2">{nearbyPlaces.filter(p=>p.slug!==place.slug).map(p=><a class="rounded-xl border border-stone-200 p-4 text-amber-800 hover:border-amber-400" href={`/${lang}/nearby/${p.slug}`}>{p[lang as 'en'|'zh'|'km'].name} →</a>)}</div></section>
  </article>
</BaseLayout>
