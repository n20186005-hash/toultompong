---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { guides } from '../../../data/guides';
import { guideLocales } from '../../../data/guideLocales';
import { siteConfig, BASE } from '../../../config/site';
export const prerender = true;

export function getStaticPaths() {
  return (['en','zh','km'] as const).flatMap(lang => guides.map((guide, index) => ({
    params: {lang, slug:guide.slug}, props: {guide,index,lang}
  })));
}
const { guide, index, lang } = Astro.props;
const localized = lang === 'en' ? undefined : guideLocales[lang as 'zh'|'km'][index];
const title = localized?.title ?? guide.title;
const lead = localized?.lead ?? guide.lead;
const path = `/${lang}/guides/${guide.slug}`;
const canonical = `${BASE}${path}`;
const alternates = ['en','zh','km'].map(code => ({code, href:`${BASE}/${code}/guides/${guide.slug}`}));
const related = guides.map((g,i)=>({g,i})).filter(({g})=>g.slug !== guide.slug).slice(0,4);
const copy = {
  en: { home:'Russian Market', guides:'Guides', label:'PHNOM PENH · VISITOR GUIDE', map:'Open Russian Market map', plan:'Plan your visit', planText:'Individual stall hours and products change. General market entry is ordinarily free; shopping, food and services cost extra. Verify current operating conditions on-site.', about:'About the market and its management', aboutText:'Phsar Tuol Tom Pong is a traditional Phnom Penh commercial market operated through many independent stalls. This guide does not attribute management to an unverified tourism operator.', highlights:'Highlights and practical advice', route:'Suggested visit sequence', basics:'Basic visitor information', location:'Address', hours:'Opening hours', hoursValue:'Commonly listed 06:00–16:30; verify individual stalls on arrival.', ticket:'Admission', ticketValue:'General entry normally free; purchases separate.', transport:'Transport', transportValue:'Tuk-tuk, taxi or suitable local transport; confirm fare and destination.', faq:'Frequently asked questions', q1:'Is this a separate attraction from Central Market?', a1:'Yes. Russian Market is in Tuol Tom Pong; Central Market is elsewhere in Phnom Penh.', q2:'Do all stalls share the same hours?', a2:'No. Individual vendors set their own opening and closing times.', photos:'Market photos and observation points', photoText:'Covered shopping aisles and the surrounding street entrances are useful places to observe market activity. Ask permission before photographing identifiable people.', lodging:'Accommodation planning', lodgingText:'Choose accommodation based on your wider Phnom Penh itinerary and current transport options; verify individual hotel details directly.', reviews:'Visitor feedback', reviewsText:'For live visitor ratings and review counts, consult the linked Google Maps market listing instead of relying on an unverified static number.', sources:'Location and information sources', updated:'Editorial update: 16 November 2026. Opening hours and facilities may change; confirm on-site.', more:'Related guides', all:'Browse all guides', steps:['Start at a street entrance and save its location.','Browse relevant stalls without rushing.','Check prices, goods and current conditions.','Return to a clear street-side pickup point.'] },
  zh: { home:'俄罗斯市场', guides:'专题指南', label:'柬埔寨金边 · 游客指南', map:'打开俄罗斯市场地图', plan:'游览建议', planText:'各摊位营业时段与商品可能变化。一般进入市场无需门票，购物、餐饮及服务另行收费；具体情况请现场核实。', about:'关于市场与管理主体', aboutText:'图尔通蓬市场是金边持续营业的传统商业市场，由众多独立商户经营。未有可靠依据时，不将市场归于某个旅游运营单位。', highlights:'特色与实用信息', route:'建议游览路线', basics:'基本资料', location:'具体地址', hours:'开放时间', hoursValue:'常见市场营业资料为 06:00–16:30，摊位具体时段请现场核实。', ticket:'门票', ticketValue:'通常可免费进入，购物和餐饮另付费。', transport:'交通方式', transportValue:'可搭突突车、出租车或其他当地交通工具；上车前确认费用与目的地。', faq:'常见问题', q1:'这里和中央市场是同一地点吗？', a1:'不是。俄罗斯市场位于图尔通蓬地区，中央市场是金边另一座市场。', q2:'所有摊位都按照同一时段营业吗？', a2:'不是。商户可自行决定营业时间，应现场核实。', photos:'实景照片与观察重点', photoText:'有顶棚的购物通道和街边入口适合观察市场生活；拍摄可辨识的人物之前请征得同意。', lodging:'住宿建议', lodgingText:'可根据整个金边行程及交通选择住处，酒店价格、设施与位置请直接向经营方核实。', reviews:'游客评价', reviewsText:'实时评分与评价数量请查看 Google 地图该市场的独立地点页面，不采用未经核实的静态数字。', sources:'地点与信息来源', updated:'内容更新：2026 年 11 月 16 日。营业与设施情况可能变化，请现场核实。', more:'相关专题', all:'查看全部指南', steps:['从街边入口进入，记录入口位置。','按兴趣浏览不同摊位，不必赶时间。','检查价格、商品和当天实际情况。','回到明确的路边接送地点。'] },
  km: { home:'ផ្សារទួលទំពូង', guides:'មគ្គុទ្ទេសក៍', label:'ភ្នំពេញ · មគ្គុទ្ទេសក៍អ្នកទស្សនា', map:'បើកផែនទីផ្សារទួលទំពូង', plan:'ការរៀបចំដំណើរ', planText:'ម៉ោង និងមុខទំនិញអាចខុសគ្នាតាមតូប។ ជាទូទៅការចូលផ្សារមិនបង់ថ្លៃ ប៉ុន្តែការទិញទំនិញ និងអាហារត្រូវបង់ប្រាក់។ សូមផ្ទៀងផ្ទាត់នៅទីតាំង។', about:'អំពីផ្សារ និងការគ្រប់គ្រង', aboutText:'ផ្សារទួលទំពូងជាផ្សារប្រពៃណីក្នុងរាជធានីភ្នំពេញដែលមានអាជីវករឯករាជ្យជាច្រើន។ មិនគួរអះអាងពីស្ថាប័នគ្រប់គ្រងទេសចរណ៍ដោយគ្មានប្រភពច្បាស់លាស់។', highlights:'ចំណុចសំខាន់ និងដំបូន្មាន', route:'លំដាប់ទស្សនាដែលណែនាំ', basics:'ព័ត៌មានមូលដ្ឋាន', location:'អាសយដ្ឋាន', hours:'ម៉ោងបើក', hoursValue:'ព័ត៌មានទូទៅបង្ហាញ ០៦:០០–១៦:៣០ ប៉ុន្តែម៉ោងតូបនីមួយៗត្រូវពិនិត្យនៅទីតាំង។', ticket:'ថ្លៃចូល', ticketValue:'ជាទូទៅចូលមើលដោយឥតគិតថ្លៃ; ទំនិញ និងអាហារគិតថ្លៃដោយឡែក។', transport:'មធ្យោបាយធ្វើដំណើរ', transportValue:'តុកតុក តាក់ស៊ី ឬមធ្យោបាយសមស្របផ្សេងទៀត; បញ្ជាក់តម្លៃ និងគោលដៅជាមុន។', faq:'សំណួរញឹកញាប់', q1:'តើទីនេះជាផ្សារធំថ្មីដែរឬទេ?', a1:'ទេ។ ផ្សារទួលទំពូង និងផ្សារធំថ្មីស្ថិតនៅទីតាំងផ្សេងគ្នាក្នុងភ្នំពេញ។', q2:'តើតូបទាំងអស់បើកម៉ោងដូចគ្នាឬទេ?', a2:'ទេ។ អាជីវករនីមួយៗអាចមានម៉ោងខុសគ្នា។', photos:'រូបភាពពិត និងចំណុចសង្កេត', photoText:'ច្រកផ្សារដែលមានដំបូល និងផ្លូវជុំវិញជាកន្លែងសង្កេតជីវភាពផ្សារ។ សុំការអនុញ្ញាតមុនថតមនុស្ស។', lodging:'ការជ្រើសកន្លែងស្នាក់នៅ', lodgingText:'ជ្រើសសណ្ឋាគារតាមកម្មវិធីទស្សនាភ្នំពេញ និងការធ្វើដំណើរ; ពិនិត្យតម្លៃ និងសេវាដោយផ្ទាល់។', reviews:'មតិអ្នកទស្សនា', reviewsText:'សូមមើលពិន្ទុ និងចំនួនមតិបច្ចុប្បន្ននៅទំព័រ Google Maps របស់ផ្សារនេះ។', sources:'ប្រភពព័ត៌មាន និងទីតាំង', updated:'កែសម្រួល ១៦ វិច្ឆិកា ២០២៦។ ព័ត៌មានប្រតិបត្តិការអាចផ្លាស់ប្តូរ សូមពិនិត្យនៅទីតាំង។', more:'មគ្គុទ្ទេសក៍ពាក់ព័ន្ធ', all:'មើលមគ្គុទ្ទេសក៍ទាំងអស់', steps:['ចូលតាមច្រកផ្លូវ និងចងចាំទីតាំង។','មើលតូបតាមចំណាប់អារម្មណ៍ដោយមិនប្រញាប់។','ពិនិត្យតម្លៃ ទំនិញ និងស្ថានភាពថ្ងៃនោះ។','ត្រឡប់ទៅកន្លែងទទួលយានជំនិះនៅខាងក្រៅ។'] },
}[lang as 'en'|'zh'|'km'];
const sections = localized ? localized.points.map((body:string,i:number)=>({heading:[copy.highlights,copy.plan,copy.transport][i],body})) : guide.sections;
const faq = localized ? [
  {q:lang==='zh'?`${title}有哪些重要事项？`:`តើគួរយល់អ្វីខ្លះអំពី ${title}?`,a:localized.points[0]},
  {q:lang==='zh'?'游览前还需要考虑什么？':'តើត្រូវត្រៀមអ្វីបន្ថែមមុនទៅទស្សនា?',a:`${localized.points[1]} ${localized.points[2]}`},
] : guide.faq;
const steps = localized ? [copy.steps[0],...localized.points] : guide.steps;
const article = { '@context':'https://schema.org','@type':'Article', headline:title,description:lead,inLanguage:lang,mainEntityOfPage:canonical,dateModified:'2026-11-16',about:{'@id':`${BASE}/#attraction`} };
// One distinct market photograph per guide; previously published gallery assets remain intact.
// Images are selected for each topic's subject where a matching scene is available.
const topicPhotos = [
  '/gallery/toul-tompong-market-14.jpg',
  '/gallery/toul-tompong-market-7.jpg',
  '/gallery/russian-market-produce.webp',
  '/gallery/russian-market-souvenirs.jpg',
  '/gallery/russian-market-textiles.jpg',
  '/gallery/toul-tompong-market-12.jpg',
  '/gallery/toul-tompong-market-5.jpg',
  '/gallery/toul-tompong-market-13.jpg',
  '/gallery/toul-tompong-market-17.jpg',
  '/gallery/toul-tompong-market-18.jpg',
  '/gallery/toul-tompong-market-3.jpg',
  '/gallery/toul-tompong-market-16.jpg',
  '/gallery/russian-market-wikimedia-11.jpg',
  '/gallery/russian-market-wikimedia-04.jpg',
  '/gallery/toul-tompong-market-15.jpg',
  '/gallery/toul-tompong-market-2.jpg',
  '/gallery/russian-market-wikimedia-09.jpg',
  '/gallery/toul-tompong-market-1.jpg',
  '/gallery/toul-tompong-market-11.jpg',
  '/gallery/toul-tompong-market-6.jpg',
  '/gallery/russian-market-entrance.jpg',
  '/gallery/toul-tompong-market-9.jpg',
  '/gallery/toul-tompong-market-8.jpg',
  '/gallery/russian-market-clothes.jpg',
  '/gallery/toul-tompong-market-4.jpg',
  '/gallery/russian-market-wikimedia-03.jpg',
  '/gallery/toul-tompong-market-10.jpg',
  '/gallery/russian-market-trinkets.jpg',
  '/gallery/russian-market-street-food.jpg',
  '/gallery/russian-market-dried-food.webp',
  '/gallery/russian-market-bags.jpg',
];
const photo = topicPhotos[index];
const separatePlaces: Record<string,{name:string;query:string}[]> = {
  'russian-market-vs-central-market': [{name:'Central Market (Phsar Thmei)',query:'Central Market Phnom Penh Cambodia'}],
  'russian-market-nearby-places': [{name:'Tuol Sleng Genocide Museum',query:'Tuol Sleng Genocide Museum Phnom Penh Cambodia'}],
  'russian-market-near-tuol-sleng': [{name:'Tuol Sleng Genocide Museum',query:'Tuol Sleng Genocide Museum Phnom Penh Cambodia'}],
  'russian-market-from-royal-palace': [{name:'Royal Palace Phnom Penh',query:'Royal Palace Phnom Penh Cambodia'}],
  'russian-market-one-day-phnom-penh': [{name:'Royal Palace',query:'Royal Palace Phnom Penh Cambodia'},{name:'Tuol Sleng Genocide Museum',query:'Tuol Sleng Genocide Museum Phnom Penh Cambodia'}],
};
const destinations = separatePlaces[guide.slug] ?? [];
const nearbyPageFor = (name:string) => name.includes('Central Market') ? 'central-market-phnom-penh' : name.includes('Tuol Sleng') ? 'tuol-sleng-genocide-museum' : null;
---
<BaseLayout lang={lang} seoTitle={`${title} | ${copy.home}`} seoDescription={lead} alternates={alternates} alternateDefault={`${BASE}/en/guides/${guide.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  <article class="mx-auto max-w-5xl px-4 py-10 text-stone-800" data-reveal>
    <nav class="mb-6 text-sm text-amber-800"><a href={`/${lang}`} class="hover:underline">{copy.home}</a> / <a href={`/${lang}/guides`} class="hover:underline">{copy.guides}</a> / {title}</nav>
    <div class="rounded-3xl bg-amber-50 px-6 py-9 sm:px-10"><p class="mb-2 text-sm font-medium tracking-wide text-amber-800">{copy.label}</p><h1 class="font-serif text-3xl font-bold leading-tight sm:text-4xl">{title}</h1><p class="mt-5 max-w-3xl leading-7 text-stone-700">{lead}</p><div class="mt-5 flex flex-wrap gap-3 text-sm"><span class="rounded-full bg-white px-3 py-2">📍 {lang==='km'?'ផ្លូវ ១៦៣ និង ៤៤០ រាជធានីភ្នំពេញ ប្រទេសកម្ពុជា':lang==='zh'?'柬埔寨金边163街与440街':'Streets 163 & 440, Phnom Penh, Cambodia'}</span><a class="rounded-full bg-amber-800 px-4 py-2 text-white hover:bg-amber-900" href={siteConfig.mapsUrl} target="_blank" rel="noopener">{copy.map} ↗</a></div></div>
    <section class="mt-9 grid gap-6 md:grid-cols-2"><div class="rounded-2xl border border-stone-200 bg-white p-6"><h2 class="font-serif text-xl font-bold">{copy.plan}</h2><p class="mt-3 leading-7">{copy.planText}</p></div><div class="rounded-2xl border border-stone-200 bg-white p-6"><h2 class="font-serif text-xl font-bold">{copy.about}</h2><p class="mt-3 leading-7">{copy.aboutText}</p></div></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">{copy.highlights}</h2><div class="mt-5 space-y-7">{sections.map((section)=> <div><h3 class="font-serif text-xl font-semibold">{section.heading}</h3><p class="mt-2 max-w-3xl leading-7 text-stone-700">{section.body}</p></div>)}</div></section>
    <section class="mt-10 rounded-2xl bg-stone-50 p-6"><h2 class="font-serif text-2xl font-bold">{copy.route}</h2><ol class="mt-4 space-y-3">{steps.map((step,i)=> <li class="flex gap-4 leading-7"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-800 text-sm text-white">{i+1}</span><span>{step}</span></li>)}</ol></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">{copy.basics}</h2><dl class="mt-4 grid gap-4 sm:grid-cols-2"><div><dt class="font-semibold">{copy.location}</dt><dd>{lang==='zh'?'柬埔寨金边12310，163街与440街交会处':lang==='km'?'កែងផ្លូវលេខ ១៦៣ និង ៤៤០ រាជធានីភ្នំពេញ ១២៣១០ ប្រទេសកម្ពុជា':siteConfig.address}</dd></div><div><dt class="font-semibold">{copy.hours}</dt><dd>{copy.hoursValue}</dd></div><div><dt class="font-semibold">{copy.ticket}</dt><dd>{copy.ticketValue}</dd></div><div><dt class="font-semibold">{copy.transport}</dt><dd>{copy.transportValue}</dd></div></dl>{destinations.length>0&&<div class="mt-5"><p class="font-semibold">{lang==='zh'?'其他独立地点地图':lang==='km'?'ផែនទីទីតាំងផ្សេងទៀត':'Separate destination maps'}</p><ul class="mt-2 space-y-2">{destinations.map(place=><li>{nearbyPageFor(place.name)&&<a class="mr-3 text-amber-800 underline" href={`/${lang}/nearby/${nearbyPageFor(place.name)}`}>{lang==='zh'?'查看景点指南':lang==='km'?'មើលមគ្គុទ្ទេសក៍':'Read attraction guide'}</a>}<a class="text-amber-800 underline" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.query)}`} target="_blank" rel="noopener">{place.name} ↗</a></li>)}</ul></div>}</section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">{copy.faq}</h2><div class="mt-4 space-y-4">{faq.map((item)=> <div class="rounded-xl border border-stone-200 p-5"><h3 class="font-semibold">{item.q}</h3><p class="mt-2 leading-7 text-stone-700">{item.a}</p></div>)}</div></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">{copy.photos}</h2><img class="mt-4 w-full rounded-2xl object-cover" src={photo} alt={`${siteConfig.name[lang as 'en'|'zh'|'km']} – ${title}`} loading="lazy" /><p class="mt-4 leading-7">{copy.photoText}</p></section>
    <section class="mt-10 grid gap-6 sm:grid-cols-2"><div><h2 class="font-serif text-xl font-bold">{copy.lodging}</h2><p class="mt-2 leading-7">{copy.lodgingText}</p></div><div><h2 class="font-serif text-xl font-bold">{copy.reviews}</h2><p class="mt-2 leading-7">{copy.reviewsText}</p></div></section>
    <section class="mt-10 border-t border-stone-200 pt-7"><h2 class="font-serif text-xl font-bold">{copy.sources}</h2><p class="mt-3 text-sm text-stone-600">{copy.updated} <a href={siteConfig.mapsUrl} target="_blank" rel="noopener" class="underline">Google Maps</a> · <a class="underline" href="https://www.tourismcambodia.com/" target="_blank" rel="noopener">Cambodia tourism</a></p><h2 class="mt-7 font-serif text-xl font-bold">{copy.more}</h2><ul class="mt-3 grid gap-3 sm:grid-cols-2">{related.map(({g,i})=> <li><a class="block rounded-xl border border-stone-200 p-4 text-amber-800 hover:border-amber-500" href={`/${lang}/guides/${g.slug}`}>{lang==='en'?g.title:guideLocales[lang as 'zh'|'km'][i].title} →</a></li>)}</ul><p class="mt-5"><a class="text-amber-800 underline" href={`/${lang}/guides`}>{copy.all}</a></p></section>
  </article>
</BaseLayout>
