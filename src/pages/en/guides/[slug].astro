---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { guides } from '../../../data/guides';
import { siteConfig } from '../../../config/site';
export const prerender = true;

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const related = guides.filter((g) => g.slug !== guide.slug).slice(0, 4);
const canonical = `https://toultompong.com/en/guides/${guide.slug}`;
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: guide.title,
  description: guide.description, inLanguage: 'en', mainEntityOfPage: canonical,
  dateModified: '2026-11-16',
  about: { '@id': 'https://toultompong.com/#attraction' },
};
---
<BaseLayout lang="en" seoTitle={`${guide.title} | Toul Tompong Market`} seoDescription={guide.description} alternates={[{code:'en',href:canonical}]} alternateDefault={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  <article class="mx-auto max-w-5xl px-4 py-10 text-stone-800" data-reveal>
    <nav class="mb-6 text-sm text-amber-800"><a href="/en" class="hover:underline">Russian Market</a> / <a href="/en/guides" class="hover:underline">Guides</a> / {guide.title}</nav>
    <div class="rounded-3xl bg-amber-50 px-6 py-9 sm:px-10">
      <p class="mb-2 text-sm font-medium tracking-wide text-amber-800">PHNOM PENH · VISITOR GUIDE</p>
      <h1 class="font-serif text-3xl font-bold leading-tight sm:text-4xl">{guide.title}</h1>
      <p class="mt-5 max-w-3xl leading-7 text-stone-700">{guide.lead}</p>
      <div class="mt-5 flex flex-wrap gap-3 text-sm"><span class="rounded-full bg-white px-3 py-2">📍 Streets 163 & 440, Phnom Penh, Cambodia</span><a class="rounded-full bg-amber-800 px-4 py-2 text-white hover:bg-amber-900" href={siteConfig.mapsUrl} target="_blank" rel="noopener">Open Russian Market map ↗</a></div>
    </div>
    <section class="mt-9 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-stone-200 bg-white p-6"><h2 class="font-serif text-xl font-bold">Plan your visit</h2><p class="mt-3 leading-7">The market is a working commercial space: stall opening times, goods and services may differ. Check current conditions on-site. General browsing does not normally require an admission ticket; purchases are extra.</p></div>
      <div class="rounded-2xl border border-stone-200 bg-white p-6"><h2 class="font-serif text-xl font-bold">About the market</h2><p class="mt-3 leading-7">Phsar Tuol Tom Pong is a traditional Phnom Penh market, commonly called Russian Market. Individual traders operate stalls; this guide does not claim that the market is managed by a single tourism operator.</p></div>
    </section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">What to know</h2><div class="mt-5 space-y-7">{guide.sections.map((section) => <div><h3 class="font-serif text-xl font-semibold">{section.heading}</h3><p class="mt-2 max-w-3xl leading-7 text-stone-700">{section.body}</p></div>)}</div></section>
    <section class="mt-10 rounded-2xl bg-stone-50 p-6"><h2 class="font-serif text-2xl font-bold">Suggested visit sequence</h2><ol class="mt-4 space-y-3">{guide.steps.map((step, i) => <li class="flex gap-4 leading-7"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-800 text-sm text-white">{i + 1}</span><span>{step}</span></li>)}</ol></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">Visitor essentials</h2><dl class="mt-4 grid gap-4 sm:grid-cols-2"><div><dt class="font-semibold">Location</dt><dd>Streets 163 and 440, Phnom Penh 12310, Cambodia</dd></div><div><dt class="font-semibold">Opening times</dt><dd>Market hours are commonly listed as 06:00–16:30; individual stalls vary. Verify locally.</dd></div><div><dt class="font-semibold">Entry</dt><dd>General market entry is normally free; shopping and food are paid separately.</dd></div><div><dt class="font-semibold">Transport</dt><dd>Use a tuk-tuk, taxi or other suitable transport; confirm the destination and fare in advance.</dd></div></dl></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">Frequently asked questions</h2><div class="mt-4 space-y-4">{guide.faq.map((item) => <div class="rounded-xl border border-stone-200 p-5"><h3 class="font-semibold">{item.q}</h3><p class="mt-2 leading-7 text-stone-700">{item.a}</p></div>)}</div></section>
    <section class="mt-10"><h2 class="font-serif text-2xl font-bold">Photos and route</h2><img class="mt-4 w-full rounded-2xl object-cover" src="/gallery/toul-tompong-market-1.jpg" alt="Toul Tompong (Russian) Market in Phnom Penh" loading="lazy" /><p class="mt-4 leading-7">For arrival, use the market’s specific <a class="text-amber-800 underline" href={siteConfig.mapsUrl} target="_blank" rel="noopener">Google Maps listing</a>. For a different destination mentioned in this article, search that destination by its own name.</p></section>
    <section class="mt-10 border-t border-stone-200 pt-7"><p class="text-sm text-stone-600">Visitor information checked 16 November 2026. Dynamic conditions should be confirmed on-site. <a class="underline" href="https://www.tourismcambodia.com/" target="_blank" rel="noopener">Cambodia tourism reference</a>.</p><h2 class="mt-7 font-serif text-xl font-bold">More independent guides</h2><ul class="mt-3 grid gap-3 sm:grid-cols-2">{related.map((g) => <li><a class="block rounded-xl border border-stone-200 p-4 text-amber-800 hover:border-amber-500" href={`/en/guides/${g.slug}`}>{g.title} →</a></li>)}</ul><p class="mt-5"><a class="text-amber-800 underline" href="/en/guides">Browse all guides</a></p></section>
  </article>
</BaseLayout>
