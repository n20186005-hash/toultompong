---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { guides } from '../../../data/guides';
export const prerender = true;
const canonical = 'https://toultompong.com/en/guides';
---
<BaseLayout lang="en" seoTitle="Russian Market Phnom Penh Visitor Guides | Shopping, Food & Tips" seoDescription="Explore practical Russian Market guides about shopping, food, prices, family visits, rainy days, photography and nearby places." alternates={[{code:'en',href:canonical}]} alternateDefault={canonical}>
  <section class="mx-auto max-w-6xl px-4 py-12" data-reveal>
    <a href="/en" class="text-sm text-amber-800 hover:underline">← Russian Market overview</a>
    <h1 class="mt-5 font-serif text-3xl font-bold sm:text-4xl">Russian Market visitor guides</h1>
    <p class="mt-4 max-w-3xl leading-7 text-stone-700">Plan a visit to Toul Tompong Market (Phsar Tuol Tom Pong) in Phnom Penh. These individual guides focus on different practical questions; check current stall conditions when you arrive.</p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{guides.map((guide) => <a href={`/en/guides/${guide.slug}`} class="rounded-2xl border border-stone-200 bg-white p-6 transition hover:border-amber-500 hover:shadow"><h2 class="font-serif text-xl font-semibold">{guide.title}</h2><p class="mt-3 text-sm leading-6 text-stone-600">{guide.description}</p><span class="mt-4 inline-block text-amber-800">Read guide →</span></a>)}</div>
  </section>
</BaseLayout>
